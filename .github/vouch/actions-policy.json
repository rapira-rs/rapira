{
    "name": "Allow Vouch PR checks",
    "enforcement": "active",
    "conditions": {
        "workflow_path": {
            "include": [".github/workflows/vouch-pr.yml"],
            "exclude": []
        }
    },
    "rules": [
        {
            "type": "restrict_action_events",
            "parameters": {
                "allowed_events": ["pull_request_target"]
            }
        }
    ]
}
